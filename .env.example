# Template only - copy to .env and fill in the secrets there.
# Everything under "Secrets" is a Render environment variable online.
# NEVER put real values in this file: it is committed to the public repo.

# --- Secrets ---
ANTHROPIC_API_KEY=
APIFY_API_TOKEN=
AUTHOR_HASH_SALT=
RUN_KEY=                    # random, >= 16 characters; never published
DATABASE_URL=               # local: Neon DEV branch (pooled);
                            # Render: Neon MAIN branch (pooled)

# --- Behaviour ---
USE_FIXTURES=false
LLM_FAKE=false
DATA_DIR=../data            # on Render: /tmp/signal (temporary)
RETENTION_DAYS=30
DAILY_SPEND_CAP_USD=25
SYNTH_MODEL_ROLE=synth      # switch to opus in models.yaml if justified
LOG_LEVEL=INFO
WORKER_MODE=inprocess       # "modal" only after Step 2.6
